{
  "name": "@styleme/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "admin": "tsx --env-file=.env scripts/admin.ts",
    "seed": "tsx --env-file=.env scripts/seed.ts",
    "reconcile": "tsx --env-file=.env scripts/reconcile-tombstones.ts",
    "style-rules": "tsx scripts/style-rules.ts",
    "evaluate": "tsx scripts/evaluate.ts",
    "migrate": "tsx --env-file=.env scripts/migrate.ts",
    "catalogue:import": "tsx --env-file=.env scripts/catalogue-import.ts",
    "illustrations:generate": "tsx scripts/profile-illustrations.ts generate",
    "illustrations:seed": "tsx --env-file=.env scripts/profile-illustrations.ts seed",
    "design:generate": "tsx scripts/design-catalogue.ts generate",
    "design:seed": "tsx --env-file=.env scripts/design-catalogue.ts seed",
    "design:drafts": "tsx scripts/design-catalogue.ts drafts",
    "colours:report": "tsx scripts/colour-library.ts report",
    "colours:drafts": "tsx scripts/colour-library.ts drafts",
    "colours:seed": "tsx --env-file=.env scripts/colour-library.ts seed"
  },
  "dependencies": {
    "@styleme/contracts": "workspace:*",
    "argon2": "^0.45.1",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.1",
    "nodemailer": "^10.1.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "5.0.3",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "^5.0.3"
  },
  "config": {
    "mongodbMemoryServer": {
      "downloadDir": "../../node_modules/.cache/mongodb-memory-server"
    }
  }
}
