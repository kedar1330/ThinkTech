# Names only — never commit values. Copy to apps/api/.env and apps/web/.env.local for local development.
# Staging and production values are set on the hosting platform after HC-1 (D-81).

# ---- API (apps/api) ----
NODE_ENV=development
PORT=4000
APP_ENV=local
MONGODB_URI=mongodb://127.0.0.1:27017/styleme
TOMBSTONE_STORE_URI=mongodb://127.0.0.1:27017/styleme_tombstones
TOMBSTONE_HMAC_KEY=
AUTH_ACCESS_TOKEN_SECRET=
BFF_SHARED_SECRET=
WEB_ORIGIN=http://localhost:3000
# Public sign-up with email-code verification (default true). Set false for invite-only (closed beta).
PUBLIC_SIGNUP_ENABLED=true
MAINTENANCE_MODE=false

# Email (verification codes and links, password reset, notices). Required in staging and production:
# the API refuses to start there without them. Locally, leave empty to write messages as JSON files
# to DEV_OUTBOX_DIR instead of sending them (git-ignored).
# Gmail example (needs 2-Step Verification and an App Password from https://myaccount.google.com/apppasswords;
# remove the spaces from the 16-character app password):
#   SMTP_URL=smtps://you%40gmail.com:abcdefghijklmnop@smtp.gmail.com:465
#   EMAIL_FROM="StyleMe <you@gmail.com>"
# Any SMTP provider works (Brevo, Resend, Amazon SES …). URL-encode special characters in the user and password.
SMTP_URL=
EMAIL_FROM=
DEV_OUTBOX_DIR=.dev-outbox
# Local only: also print each email/SMS code and link in the API terminal (default true). Ignored
# outside APP_ENV=local, so staging and production never print codes.
DEV_ECHO_MESSAGES=true

# SMS for optional phone verification (D-92). No provider is integrated yet: locally codes go to the
# dev outbox; elsewhere phone verification reports "not available".
SMS_PROVIDER=none

# Google sign-in (D-88). The API verifies Google ID tokens against this client ID. Leave empty to
# disable Google sign-in (the buttons show "not available yet").
GOOGLE_CLIENT_ID=

# Admin seed (D-95), read only by `pnpm seed` (scripts/seed.ts). The password must meet the password
# policy. Set these just for the seed run and remove the password afterwards; it is never logged.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=

# ---- Web (apps/web) ----
AUTH_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000
# BFF_SHARED_SECRET must be the same value as the API's.
# Google OAuth client (web application type). Authorised redirect URI: ${AUTH_URL}/api/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
