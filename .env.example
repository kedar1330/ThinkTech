# Names only — never commit values. Copy to apps/api/.env and apps/web/.env.local for local development.
# Staging and production values are set on the hosting platform after HC-1 (D-81).

# ---- API (apps/api) ----
NODE_ENV=development
PORT=4000
APP_ENV=local
MONGODB_URI=mongodb://127.0.0.1:27017/styleme
TOMBSTONE_STORE_URI=mongodb://127.0.0.1:27017/styleme_tombstones
TOMBSTONE_HMAC_KEY=
AUTH_ACCESS_TOKEN_SECRET=
BFF_SHARED_SECRET=
WEB_ORIGIN=http://localhost:3000
# Public sign-up with email-code verification (default true). Set false for invite-only (closed beta).
PUBLIC_SIGNUP_ENABLED=true
MAINTENANCE_MODE=false

# Email (verification codes and links, password reset, notices). Required in staging and production:
# the API refuses to start there without them. Locally, leave empty to write messages as JSON files
# to DEV_OUTBOX_DIR instead of sending them (git-ignored).
# Gmail example (needs 2-Step Verification and an App Password from https://myaccount.google.com/apppasswords;
# remove the spaces from the 16-character app password):
#   SMTP_URL=smtps://you%40gmail.com:abcdefghijklmnop@smtp.gmail.com:465
#   EMAIL_FROM="StyleMe <you@gmail.com>"
# Any SMTP provider works (Brevo, Resend, Amazon SES …). URL-encode special characters in the user and password.
SMTP_URL=
EMAIL_FROM=
DEV_OUTBOX_DIR=.dev-outbox
# Local only: also print each email/SMS code and link in the API terminal (default true). Ignored
# outside APP_ENV=local, so staging and production never print codes.
DEV_ECHO_MESSAGES=true

# SMS for optional phone verification (D-92). No provider is integrated yet: locally codes go to the
# dev outbox; elsewhere phone verification reports "not available".
SMS_PROVIDER=none

# Google sign-in (D-88). The API verifies Google ID tokens against this client ID. Leave empty to
# disable Google sign-in (the buttons show "not available yet").
GOOGLE_CLIENT_ID=

# Optional AI wording of look explanations (D-67): off by default. When true, GEMINI_API_KEY and
# GEMINI_MODEL are required; only rule references and attribute labels are ever sent (AI rule 16).
AI_WORDING_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=
AI_WORDING_TIMEOUT_MS=4000

# Photo analysis by Gemini (D-129): face photo -> skin tone + undertone, full-body photo -> body type.
# Live whenever GEMINI_API_KEY (above) is set. Get a key at https://aistudio.google.com/apikey.
# Set PHOTO_ANALYSIS_ENABLED=false to switch it off; users can then still choose manually.
PHOTO_ANALYSIS_ENABLED=true
GEMINI_VISION_MODEL=gemini-3.8-flash
PHOTO_ANALYSIS_TIMEOUT_MS=90000

# AI outfit images on looks, made by Pollinations the first time a look is viewed and stored with it.
# Local only and off by default until the founder approves showing unreviewed AI images (D-62, D-65).
# The prompt holds the look's garments, colours and occasion only, never anything about the user's body.
# Secret key (sk_...) from https://enter.pollinations.ai; API only, never in the web app.
OUTFIT_IMAGES_ENABLED=false
POLLINATIONS_API_KEY=
POLLINATIONS_IMAGE_MODEL=black-forest-labs/flux.1-schnell
OUTFIT_IMAGE_TIMEOUT_MS=60000

# Price ranges on Shop My Look tabs (#118): Amazon, Flipkart and Meesho listings found with Serper.dev
# (https://serper.dev). Live whenever the key is set, with APP_ENV=local only until the founder approves
# showing store prices (D-77). A query is a garment's search phrase and the department, nothing about the user.
SERPER_API_KEY=
PRICE_SEARCH_TIMEOUT_MS=8000

# Design Studio (D-134): sketch / upload / description / look + change -> design picture + tailor spec.
# Live whenever GEMINI_API_KEY is set (DESIGN_STUDIO_ENABLED=false switches it off). Gemini (GEMINI_VISION_MODEL)
# reads the sketch and writes the spec. Pictures: Pollinations first (the POLLINATIONS_API_KEY and
# POLLINATIONS_IMAGE_MODEL above, used even while OUTFIT_IMAGES_ENABLED=false), then Cloudflare Workers AI as
# the fallback (account ID + API token with "Workers AI" access). Each image service is used only when its key
# is set; with neither, designs get a spec but no picture.
DESIGN_STUDIO_ENABLED=true
DESIGN_ANALYSIS_TIMEOUT_MS=60000
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
IMAGE_GENERATION_TIMEOUT_MS=45000

# Style Assistant (D-136): chat that runs the right feature (looks, colours, palettes, designs, saved, shop).
# Always on. With GEMINI_API_KEY set, Gemini (GEMINI_MODEL, else GEMINI_VISION_MODEL) reads the question and writes
# the reply from the feature's results (never photos, measurements, height or appearance labels);
# STYLE_ASSISTANT_AI_ENABLED=false uses only the keyword matcher and fixed wording.
STYLE_ASSISTANT_AI_ENABLED=true
STYLE_ASSISTANT_TIMEOUT_MS=15000
# 3D Virtual Try-On (D-137): the user's full-body try-on photo + a similar item's store thumbnail -> fal.ai.
# FASHN dresses the photo, TRELLIS turns the result into a 3D model. Live whenever FAL_KEY is set
# (TRY_ON_ENABLED=false switches it off); only after the user agrees to the try-on notice each time.
# It uses Shop My Look's similar items, so it needs SERPER_API_KEY too. Key from https://fal.ai/dashboard/keys;
# API only, never in the web app.
TRY_ON_ENABLED=true
FAL_KEY=
FAL_TRY_ON_MODEL=fal-ai/fashn/tryon/v1.6
FAL_3D_MODEL=fal-ai/trellis
# Free cartoon avatar try-on (D-138): a shared Bitmoji-style avatar is dressed in the store's items by Pollinations
# image editing (models offered without paid Pollen), using POLLINATIONS_API_KEY above. No user data is sent.
DRAPE_ENABLED=true
DRAPE_MODELS=black-forest-labs/flux.2-klein-4b,openai/gpt-image-1-mini
DRAPE_TIMEOUT_MS=90000
TRY_ON_REQUEST_TIMEOUT_MS=30000
TRY_ON_STEP_TIMEOUT_MS=300000

# Admin seed (D-95), read only by `pnpm seed` (scripts/seed.ts). The password must meet the password
# policy. Set these just for the seed run and remove the password afterwards; it is never logged.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=

# ---- Web (apps/web) ----
AUTH_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000
# BFF_SHARED_SECRET must be the same value as the API's.
# Google OAuth client (web application type). Authorised redirect URI: ${AUTH_URL}/api/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
